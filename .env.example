# ── Booking ("Let's Talk" dialog) ────────────────────────
# Full Calendly event URLs. All three are REQUIRED — a missing one is
# reported to the console and that card opens an email fallback rather
# than silently booking into the wrong meeting.
#
#   EXPLORE         → Investor Conversation   (30 min)
#   DESIGN_PARTNER  → Become a Design Partner (45 min)
#   ENTERPRISE      → Enterprise Evaluation   (60 min)
#
# NEXT_PUBLIC_* is inlined at BUILD time — set these in Vercel too and
# redeploy after changing one. A restart is not enough.
NEXT_PUBLIC_CALENDLY_EXPLORE=https://calendly.com/astravision-global/new-meeting
NEXT_PUBLIC_CALENDLY_DESIGN_PARTNER=https://calendly.com/astravision-global/design-partner-program
NEXT_PUBLIC_CALENDLY_ENTERPRISE=https://calendly.com/astravision-global/enterprise-evaluation

# ── Analytics (optional) ─────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
