# ── Booking ("Book Demo" dialog) ─────────────────────────
# Full Calendly event URLs. All three are optional per-card — a
# missing URL is reported to the console and that card opens an
# email fallback rather than silently booking into the wrong meeting.
#
# Mapping (matches lib/meetings.ts):
#   NEXT_PUBLIC_CALENDLY_EXPLORE         → "Explore NavisLabs"      (30 min)
#   NEXT_PUBLIC_CALENDLY_DESIGN_PARTNER  → "Design Partner"         (45 min)
#   NEXT_PUBLIC_CALENDLY_ENTERPRISE      → "Investor Conversation"  (30 min)
#
# NEXT_PUBLIC_* is inlined at BUILD time — set these in Vercel too
# and redeploy after changing one. A restart is not enough.
#
# The values below are illustrative placeholders. Replace with your
# organization's Calendly event URLs.
NEXT_PUBLIC_CALENDLY_EXPLORE=https://calendly.com/your-org/explore-navislabs
NEXT_PUBLIC_CALENDLY_DESIGN_PARTNER=https://calendly.com/your-org/design-partner
NEXT_PUBLIC_CALENDLY_ENTERPRISE=https://calendly.com/your-org/investor-conversation

# ── Analytics (optional) ─────────────────────────────────
# Leave NEXT_PUBLIC_POSTHOG_KEY empty to disable PostHog entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
